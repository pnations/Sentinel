# SentinelH20 environment configuration
# Copy to .env for local development.

# PostgreSQL connection string (UTC timestamps are enforced in application logic)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sentinelh20

# OpenAI key (server-side only; never expose in frontend)
OPENAI_API_KEY=

# NVD API key for CVE/CPE enrichment
NVD_API_KEY=

# CISA KEV feed URL
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# API port
PORT=4000
